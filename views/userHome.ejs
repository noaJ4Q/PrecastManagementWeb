<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <link rel="icon" type="image/x-icon" href="https://cdn.autodesk.io/favicon.ico">
  <link rel="stylesheet" href="https://developer.api.autodesk.com/modelderivative/v2/viewers/7.*/style.css">
  <link rel="stylesheet" href="/main.css">
  <link rel="stylesheet" href="/output.css">
  <title>Precast Management Web</title>
</head>

<body class="bg-gray-50 font-sans">
  <p class="hidden" id="isFirstLoad">false</p>
  <!-- Header -->
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="flex items-center justify-between px-6 py-4">
      <div class="flex items-center space-x-4">
        <!-- <img class="logo h-8" src="https://cdn.autodesk.io/logo/black/stacked.png" alt="Autodesk Platform Services"> -->
        <h1 class="title text-xl font-semibold text-gray-800">Precast Management Web</h1>
      </div>
      <div class="flex items-center space-x-3">
        <select name="models" id="models"
          class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"></select>
        <button id="upload" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          title="Upload New Model">Upload</button>
        <input style="display: none" type="file" id="input">
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="flex h-[calc(100vh-73px)]">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 overflow-y-auto">
      <nav class="p-4">
        <ul class="space-y-1">
          <li>
            <a href="#dashboard" class="flex items-center px-4 py-3 text-gray-700 bg-blue-50 rounded-lg">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
                </path>
              </svg>
              Dashboard
            </a>
          </li>
          <li>
            <a href="#elements"
              class="flex items-center px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-lg transition-colors">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                </path>
              </svg>
              Elements
            </a>
          </li>
          <li>
            <a href="#" class="flex items-center px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-lg transition-colors">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                </path>
              </svg>
              Reports
            </a>
          </li>
          <li>
            <a href="#tags"
              class="flex items-center px-4 py-3 text-gray-600 hover:bg-gray-50 rounded-lg transition-colors">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z">
                </path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Tags
            </a>
          </li>
        </ul>
      </nav>
    </aside>


    <!-- Main Viewer Area -->
    <main class="flex-1 p-6 overflow-auto">
      <!-- Dashboard -->
      <section class="bg-white rounded-lg shadow-sm border border-gray-200 h-full mb-6" id="dashboard">
        <div class="border-b border-gray-200 px-6 py-4">
          <h2 class="text-lg font-semibold text-gray-800">Dashboard</h2>
        </div>
        <div id="preview" class="h-[calc(100%-57px)] relative">
          <!-- Autodesk -->
          <div class="absolute inset-0 flex items-center justify-center text-gray-400">
            <div class="text-center">
              <svg class="w-16 h-16 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                </path>
              </svg>
              <p class="text-sm">Select or upload a model to view</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Elements -->
      <section class="bg-white rounded-lg shadow-sm border border-gray-200 min-h-[500px] flex flex-col mb-6"
        id="elements">
        <div class="border-b border-gray-200 px-6 py-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-800">Elements</h2>
          <button id="addElementBtn"
            class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700 transition-colors">
            Add element
          </button>
        </div>
        <div class="flex-1 p-6 overflow-auto">
          <div id="elementsList">
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-gray-200">
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold w-16">#</th>
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold">Name</th>
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold">Type</th>
                    <!-- <th class="text-left py-3 px-3 text-gray-600 font-semibold">Width</th> -->
                    <!-- <th class="text-left py-3 px-3 text-gray-600 font-semibold">Height</th> -->
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold">RFID Tag</th>
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold">Status</th>
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold">Expected delivery</th>
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold">Expected installation</th>
                    <th class="text-right py-3 px-3 text-gray-600 font-semibold w-32">Actions</th>
                  </tr>
                </thead>
                <tbody id="elementsTableBody">

                  <% elements.forEach((element, index)=> { %>
                    <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                      <td class="py-3 px-3 text-gray-500">
                        <%= index + 1 %>
                      </td>
                      <td class="py-3 px-3 text-gray-700 font-medium">
                        <%= element.name %>
                      </td>
                      <td class="py-3 px-3 text-gray-600">
                        <%= element.type %>
                      </td>
                      <td class="py-3 px-3">
                        <span
                          class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                          <%= element.rfid_tag %>
                        </span>
                      </td>
                      <td class="py-3 px-3 text-gray-600">
                        <%= element.status %>
                      </td>
                      <td class="py-3 px-3 text-gray-600">
                        <%= element.expected_delivery %>
                      </td>
                      <td class="py-3 px-3 text-gray-600">
                        <%= element.expected_installation %>
                      </td>
                      <td class="py-3 px-3 text-right">
                        <button class="text-blue-600 hover:text-blue-800 text-sm font-medium mr-3">Edit</button>
                        <button class="text-red-600 hover:text-red-800 text-sm font-medium">Remove</button>
                      </td>
                    </tr>
                    <% }) %>

                      <!-- 
                    Template element row
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="py-3 px-3 text-gray-500">5</td>
                        <td class="py-3 px-3 text-gray-700 font-medium">Roof Truss E</td>
                        <td class="py-3 px-3 text-gray-600">6.0m</td>
                        <td class="py-3 px-3 text-gray-600">1.2m</td>
                        <td class="py-3 px-3">
                          <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            RFID-004-G8H3
                          </span>
                        </td>
                        <td class="py-3 px-3 text-right">
                          <button class="text-blue-600 hover:text-blue-800 text-sm font-medium mr-3">Edit</button>
                          <button class="text-red-600 hover:text-red-800 text-sm font-medium">Remove</button>
                        </td>
                      </tr> -->
                </tbody>
              </table>
            </div>
            <!-- No elements message -->
            <!-- <p class="text-gray-400 text-sm">No elements added yet</p> -->
          </div>
        </div>
      </section>

      <!-- Tags -->
      <section class="bg-white rounded-lg shadow-sm border border-gray-200 min-h-[500px] flex flex-col mb-6" id="tags">
        <div class="border-b border-gray-200 px-6 py-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-800">Tags</h2>
          <button id="addTagBtn"
            class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700 transition-colors">
            Add tag
          </button>
        </div>
        <div class="flex-1 p-6 overflow-auto">
          <div id="tagsList">
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-gray-200">
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold w-16">#</th>
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold">RFID ID</th>
                    <th class="text-left py-3 px-3 text-gray-600 font-semibold">Used</th>
                    <th class="text-right py-3 px-3 text-gray-600 font-semibold w-24">Actions</th>
                  </tr>
                </thead>
                <tbody id="tagsTableBody">
                  <% tags.forEach((tag, index)=> { %>
                    <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                      <td class="py-3 px-3 text-gray-500">
                        <%= index + 1 %>
                      </td>
                      <td class="py-3 px-3 text-gray-700 font-medium">
                        <%= tag.rfid_id %>
                      </td>
                      <td class="py-3 px-3">
                        <% if (tag.used) { %>
                          <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Yes
                          </span>
                          <% } else { %>
                            <span
                              class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                              No
                            </span>
                            <% } %>
                      </td>
                      <td class="py-3 px-3 text-right">
                        <button class="text-red-600 hover:text-red-800 text-sm font-medium">Remove</button>
                      </td>
                      <% }) %>
                        <!-- 
                      Template tag row
                      <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                      <td class="py-3 px-3 text-gray-500">1</td>
                      <td class="py-3 px-3 text-gray-700 font-medium">RFID-001-A4B2</td>
                      <td class="py-3 px-3">
                        <span
                          class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          Yes
                        </span>
                      </td>
                      <td class="py-3 px-3 text-right">
                        <button class="text-red-600 hover:text-red-800 text-sm font-medium">Remove</button>
                      </td>
                    </tr> -->
                </tbody>
              </table>
            </div>
            <!-- No tags message -->
            <!-- <p class="text-gray-400 text-sm">No tags added yet</p> -->
          </div>
        </div>
      </section>
    </main>
  </div>

  <div id="overlay"></div>

  <!-- Modal add element -->
  <div id="addElementModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4">
      <div class="border-b border-gray-200 px-6 py-4">
        <h3 class="text-lg font-semibold text-gray-800">Add New Element</h3>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Prefabricated Name</label>
          <input type="text" id="elementNameInput" placeholder="Enter prefabricated name"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Associated Tag</label>
          <select id="elementTagSelect"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">Select a tag</option>
          </select>
        </div>
      </div>
      <div class="border-t border-gray-200 px-6 py-4 flex justify-end space-x-3">
        <button id="cancelElementBtn"
          class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
          Cancel
        </button>
        <button id="confirmElementBtn"
          class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
          Add Element
        </button>
      </div>
    </div>
  </div>

  <!-- Modal add tag -->
  <div id="addTagModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4">
      <div class="border-b border-gray-200 px-6 py-4">
        <h3 class="text-lg font-semibold text-gray-800">Add New Tag</h3>
      </div>
      <div class="p-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Tag ID</label>
        <input type="text" id="tagIdInput" placeholder="Enter tag ID"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div class="border-t border-gray-200 px-6 py-4 flex justify-end space-x-3">
        <button id="cancelTagBtn"
          class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
          Cancel
        </button>
        <button id="confirmTagBtn"
          class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
          Add Tag
        </button>
      </div>
    </div>
  </div>

  <script src="https://developer.api.autodesk.com/modelderivative/v2/viewers/7.*/viewer3D.js"></script>
  <script src="/main.js" type="module"></script>
  <script src="/manage.js" type="module"></script>
</body>

</html>